{
  "name": "@danieljamestronca/app-icon-3d-cli",
  "version": "0.1.0",
  "description": "Export local app-icon images as portable 3D GLB files.",
  "keywords": [
    "glb",
    "gltf",
    "3d",
    "app-icon",
    "icon",
    "export",
    "cli",
    "squircle",
    "sharp"
  ],
  "license": "MIT",
  "author": "Daniel James Tronca",
  "homepage": "https://app-icon-3d-demo.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielJamesTronca/app-icon-3d.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/DanielJamesTronca/app-icon-3d/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "bin": {
    "app-icon-3d": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@gltf-transform/core": "^4.2.1",
    "sharp": "^0.34.2"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@danieljamestronca/app-icon-3d-core": "workspace:*"
  }
}

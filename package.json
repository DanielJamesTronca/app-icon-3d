{
  "name": "app-icon-3d",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "engines": { "node": ">=22.14" },
  "scripts": {
    "build": "pnpm --filter @danieljamestronca/app-icon-3d-core build && pnpm --filter './packages/*' build",
    "build:demo": "pnpm build && pnpm --filter demo build",
    "lint": "eslint .",
    "typecheck": "tsc -b && pnpm --filter './packages/*' typecheck && pnpm --filter demo typecheck",
    "test": "vitest run",
    "test:demo": "playwright test",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "pnpm build && pnpm --filter @danieljamestronca/app-icon-3d pack --pack-destination .packs && pnpm --filter @danieljamestronca/app-icon-3d-cli pack --pack-destination .packs"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@changesets/cli": "^2.29.5",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.6.2",
    "@playwright/test": "^1.54.1",
    "tsup": "^8.5.0",
    "typescript-eslint": "^8.38.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
